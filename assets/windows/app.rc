// Filled in by build.rs (ICON_PATH, VERSION_*). Icon 1 is what gpui loads for the window and taskbar (gpui-pre-windows `load_icon`).
1 ICON "ICON_PATH"

// Task Manager and Explorer name the process by FileDescription, else by the file name.
1 VERSIONINFO
FILEVERSION     VERSION_TUPLE
PRODUCTVERSION  VERSION_TUPLE
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "frstycodes"
      VALUE "FileDescription",  "Dango"
      VALUE "ProductName",      "Dango"
      VALUE "InternalName",     "dango"
      VALUE "OriginalFilename", "Dango.exe"
      VALUE "FileVersion",      VERSION_STRING
      VALUE "ProductVersion",   VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
